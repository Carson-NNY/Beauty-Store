# Supabase pooled connection string for Prisma Client at runtime.
DATABASE_URL="postgresql://postgres.project-ref:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"


# Supabase direct connection string for Prisma migrations.
DIRECT_URL="postgresql://postgres.project-ref:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"


NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email notifications. Leave EMAIL_PROVIDER_API_KEY empty in local development to log emails to the server console.
